{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "lockward",
          "version": "0.1.0",
          "informationUri": "https://github.com/Breaktroughf1/lockward",
          "rules": [
            {
              "id": "drift-modified",
              "name": "asset-modified",
              "shortDescription": {
                "text": "Agent asset changed since it was approved"
              },
              "fullDescription": {
                "text": "The content of a skill, MCP server definition, hook, rules file or setting differs from lockward.lock."
              },
              "help": {
                "text": "Review with 'lockward diff <id>' and accept with 'lockward approve <id>'."
              },
              "helpUri": "https://github.com/Breaktroughf1/lockward/blob/main/docs/USAGE.md#verify",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain",
                  "drift"
                ]
              }
            },
            {
              "id": "drift-added",
              "name": "asset-added",
              "shortDescription": {
                "text": "Agent asset not in the lockfile"
              },
              "fullDescription": {
                "text": "An agent would load an asset that has never been approved."
              },
              "help": {
                "text": "Review the asset and accept it with 'lockward approve <id>'."
              },
              "helpUri": "https://github.com/Breaktroughf1/lockward/blob/main/docs/USAGE.md#verify",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain",
                  "drift"
                ]
              }
            },
            {
              "id": "drift-removed",
              "name": "asset-removed",
              "shortDescription": {
                "text": "Approved agent asset is missing"
              },
              "fullDescription": {
                "text": "An asset recorded in lockward.lock is no longer present."
              },
              "help": {
                "text": "Accept the removal with 'lockward approve <id>'."
              },
              "helpUri": "https://github.com/Breaktroughf1/lockward/blob/main/docs/USAGE.md#verify",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain",
                  "drift"
                ]
              }
            },
            {
              "id": "LW001",
              "name": "unpinned-mcp-package",
              "shortDescription": {
                "text": "MCP server launched from a package without an exact version or image digest"
              },
              "fullDescription": {
                "text": "MCP server launched from a package without an exact version or image digest"
              },
              "help": {
                "text": "Pin an exact version (npx pkg@1.2.3, uvx pkg==1.2.3) or an image digest (image@sha256:...)."
              },
              "helpUri": "https://github.com/Breaktroughf1/lockward/blob/main/docs/POLICY.md#lw001",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain",
                  "policy"
                ]
              }
            },
            {
              "id": "LW002",
              "name": "source-not-allowed",
              "shortDescription": {
                "text": "Skill or MCP source is not in allow.sources"
              },
              "fullDescription": {
                "text": "Skill or MCP source is not in allow.sources"
              },
              "help": {
                "text": "Add the source to allow.sources in lockward.policy.yaml after review, or remove the asset."
              },
              "helpUri": "https://github.com/Breaktroughf1/lockward/blob/main/docs/POLICY.md#lw002",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain",
                  "policy"
                ]
              }
            },
            {
              "id": "LW003",
              "name": "hook-executes-network",
              "shortDescription": {
                "text": "Hook command or script invokes a network tool"
              },
              "fullDescription": {
                "text": "Hook command or script invokes a network tool"
              },
              "help": {
                "text": "Remove network access from the hook, or add an exception with a reason after review."
              },
              "helpUri": "https://github.com/Breaktroughf1/lockward/blob/main/docs/POLICY.md#lw003",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain",
                  "policy"
                ]
              }
            },
            {
              "id": "LW004",
              "name": "external-url-reference",
              "shortDescription": {
                "text": "Prose instructs fetching or executing from a domain not in allow.domains"
              },
              "fullDescription": {
                "text": "Prose instructs fetching or executing from a domain not in allow.domains"
              },
              "help": {
                "text": "Review the instruction; add the domain to allow.domains if it is trusted."
              },
              "helpUri": "https://github.com/Breaktroughf1/lockward/blob/main/docs/POLICY.md#lw004",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain",
                  "policy"
                ]
              }
            },
            {
              "id": "LW005",
              "name": "secret-path-reference",
              "shortDescription": {
                "text": "References credential stores such as ~/.ssh, ~/.aws, .env, keychains or browser profiles"
              },
              "fullDescription": {
                "text": "References credential stores such as ~/.ssh, ~/.aws, .env, keychains or browser profiles"
              },
              "help": {
                "text": "Confirm the reference is legitimate; otherwise remove the asset."
              },
              "helpUri": "https://github.com/Breaktroughf1/lockward/blob/main/docs/POLICY.md#lw005",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain",
                  "policy"
                ]
              }
            },
            {
              "id": "LW006",
              "name": "executable-in-skill",
              "shortDescription": {
                "text": "Skill contains a compiled, bytecode or binary executable, or an archive"
              },
              "fullDescription": {
                "text": "Skill contains a compiled, bytecode or binary executable, or an archive"
              },
              "help": {
                "text": "Remove the file, or add an exception with a reason after reviewing it."
              },
              "helpUri": "https://github.com/Breaktroughf1/lockward/blob/main/docs/POLICY.md#lw006",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain",
                  "policy"
                ]
              }
            },
            {
              "id": "LW007",
              "name": "env-value-inline",
              "shortDescription": {
                "text": "Secret written inline in an MCP or hook config instead of an environment reference"
              },
              "fullDescription": {
                "text": "Secret written inline in an MCP or hook config instead of an environment reference"
              },
              "help": {
                "text": "Move the value to an environment variable and reference it (e.g. \"${API_KEY}\"); rotate the exposed secret."
              },
              "helpUri": "https://github.com/Breaktroughf1/lockward/blob/main/docs/POLICY.md#lw007",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain",
                  "policy"
                ]
              }
            },
            {
              "id": "LW008",
              "name": "auto-approve-tools",
              "shortDescription": {
                "text": "Agent settings auto-approve tools or commands without confirmation"
              },
              "fullDescription": {
                "text": "Agent settings auto-approve tools or commands without confirmation"
              },
              "help": {
                "text": "Remove the auto-approval, or narrow it to specific read-only tools."
              },
              "helpUri": "https://github.com/Breaktroughf1/lockward/blob/main/docs/POLICY.md#lw008",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "supply-chain",
                  "policy"
                ]
              }
            }
          ]
        }
      },
      "originalUriBaseIds": {
        "PROJECTROOT": {
          "description": {
            "text": "The project root (directory containing lockward.lock)."
          }
        },
        "USERHOME": {
          "description": {
            "text": "The user's home directory (user scope)."
          }
        }
      },
      "results": [
        {
          "ruleId": "drift-added",
          "ruleIndex": 1,
          "level": "warning",
          "message": {
            "text": "mcp mcp:cursor:new added (.cursor/mcp.json#/mcpServers/new) at JSON pointer /mcpServers/new. Review it, then accept: lockward approve mcp:cursor:new"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".cursor/mcp.json",
                  "uriBaseId": "PROJECTROOT"
                }
              }
            }
          ],
          "partialFingerprints": {
            "lockward/v1": "60c78b26cb93e371bfe3fead15649c9e"
          },
          "properties": {
            "entryId": "mcp:cursor:new",
            "scope": "project",
            "status": "added"
          }
        },
        {
          "ruleId": "drift-removed",
          "ruleIndex": 2,
          "level": "error",
          "message": {
            "text": "rules rules:generic:AGENTS.md removed (AGENTS.md). Accept the removal: lockward approve rules:generic:AGENTS.md"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "lockward.lock",
                  "uriBaseId": "PROJECTROOT"
                }
              }
            }
          ],
          "partialFingerprints": {
            "lockward/v1": "3e89f2718fcdde8cc1e7b5122f2b2773"
          },
          "properties": {
            "entryId": "rules:generic:AGENTS.md",
            "scope": "project",
            "status": "removed"
          }
        },
        {
          "ruleId": "drift-modified",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "skill skill:claude-code:pdf tools modified (.claude/skills/pdf tools). Review: lockward diff 'skill:claude-code:pdf tools'; accept: lockward approve 'skill:claude-code:pdf tools'"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".claude/skills/pdf%20tools",
                  "uriBaseId": "PROJECTROOT"
                }
              }
            }
          ],
          "partialFingerprints": {
            "lockward/v1": "5e928027113d07785039740100ef9c86"
          },
          "properties": {
            "entryId": "skill:claude-code:pdf tools",
            "scope": "project",
            "status": "modified"
          }
        },
        {
          "ruleId": "LW001",
          "ruleIndex": 3,
          "level": "error",
          "message": {
            "text": "mcp:cursor:new: MCP server \"new\" runs npm package \"x\" without an exact version. Fix: Pin it."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".cursor/mcp.json",
                  "uriBaseId": "PROJECTROOT"
                }
              }
            }
          ],
          "partialFingerprints": {
            "lockward/v1": "8c8d36d10164f25e510b52533b86f667"
          },
          "properties": {
            "entryId": "mcp:cursor:new",
            "scope": "project"
          }
        },
        {
          "ruleId": "LW004",
          "ruleIndex": 6,
          "level": "warning",
          "message": {
            "text": "skill:claude-code:pdf tools: instructs fetching or executing from evil.example.com. Fix: Review."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".claude/skills/pdf%20tools/SKILL.md",
                  "uriBaseId": "PROJECTROOT"
                },
                "region": {
                  "startLine": 3
                }
              }
            }
          ],
          "partialFingerprints": {
            "lockward/v1": "2693d91bcdded9da09e9d4c50d41b593"
          },
          "properties": {
            "entryId": "skill:claude-code:pdf tools",
            "scope": "project"
          }
        }
      ]
    }
  ]
}
