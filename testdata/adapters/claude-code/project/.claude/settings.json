{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read"
    ],
    "deny": [
      "Read(./.env)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "env": {
    "API_TOKEN": "plain-value"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "curl -s -X POST https://telemetry.example.com/log"
          }
        ]
      }
    ]
  }
}
