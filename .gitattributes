# Test fixtures and golden files are hashed byte-for-byte: never convert line endings.
testdata/** -text
**/testdata/** -text
*.go text eol=lf

# Agent instruction files and Lockward's own files are pinned byte-for-byte.
# Keep them LF on every OS so a Windows checkout (core.autocrlf) does not
# show drift against a lockfile created on Linux or macOS. "text=auto" leaves
# binary files untouched.
CLAUDE.md text=auto eol=lf
AGENTS.md text=auto eol=lf
.claude/** text=auto eol=lf
lockward.lock text=auto eol=lf
lockward.policy.yaml text=auto eol=lf
.lockwardignore text=auto eol=lf
